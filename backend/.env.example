# IMPACT backend configuration. Copy to backend/.env for local use (never commit .env).
# On Render, set these in the service "Environment" tab instead.

# --- Gemini (optional). Without it the app still shows the computed summary. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=40
# Voice ("Escuchar resultados"). Empty = auto-detect the best TTS model available to the key
# (v1beta: gemini-3.8-flash-tts, gemini-3.1-flash-tts-preview, gemini-2.5-flash-preview-tts).
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE_ES=Kore
GEMINI_TTS_VOICE_EN=Kore

# --- NASA Earthdata (required for Subsidence and Glaciers / NISAR) ---
# Use a token (recommended, https://urs.earthdata.nasa.gov/ -> Generate Token)...
EARTHDATA_TOKEN=
# ...or username + password.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Collections searched in order (validated first, then provisional).
NISAR_COLLECTIONS=NISAR_L2_GUNW_V1,NISAR_L2_GUNW_PROVISIONAL_V1
# Max consecutive 12-day pairs chained in the subsidence history (each pair = one remote read).
NISAR_MAX_PAIRS=6
# stream = read only the needed window over HTTPS (recommended); download = full ~1.4 GB file.
NISAR_ACCESS_MODE=stream
# Phase-to-LOS sign: d = SIGN * lambda/(4*pi) * phase. Keep -1 unless validated otherwise.
NISAR_PHASE_SIGN=-1

# --- Web / deployment ---
# Comma-separated origins allowed by CORS. Leave empty when frontend and API share the same origin.
ALLOWED_ORIGINS=
# Public URL of the app (used in the User-Agent sent to OpenStreetMap services).
PUBLIC_APP_URL=
# Optional CARTO basemap key (public, restrict it to your domain in the CARTO dashboard).
CARTO_API_KEY=

# --- Resources ---
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=900
RESULT_TTL_SECONDS=21600
MAX_AREA_KM2=20000
MAX_FOREST_PIXELS=12000000
# Regenerable cache (ephemeral on Render free).
CACHE_DIR=/tmp/impact-cache
