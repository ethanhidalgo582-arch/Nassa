# Solo el servidor recibe esta clave. Nunca ponerla en Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=40
# Flutter web: ejecutar con --web-port 3000 o ajustar esta lista.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EARTHDATA_USERNAME=tu_usuario_nasa
EARTHDATA_PASSWORD=tu_contraseña_nasa